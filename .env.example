# FORTRESS Environment Configuration Template
# Copy to .env for local runtime overrides

# 1. Server Configuration
PORT=3005
NODE_ENV=development
CORS_ORIGIN=*

# 2. PostgreSQL Database Connection
# Uses local socket authentication by default for seamless setup
DATABASE_URL=postgres:///fortress?host=/var/run/postgresql
DATABASE_TEST_URL=postgres:///fortress_test?host=/var/run/postgresql

# 3. Stellar Network & Soroban Configuration
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# 4. Smart Contract Addresses (Stellar Testnet)
FORTRESS_CONTRACT_ID=CC5J3P7BFORTRESS6R6R6R6R6R6R6R6R6R6R6R6R6R6R6R6R6R6R6SECURE

# 5. Circle USDC on Stellar Testnet
STELLAR_USDC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCUSDC

# 6. Client Configuration
VITE_API_URL=http://localhost:3005

